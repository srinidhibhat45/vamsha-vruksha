# Copy to .env.local.
#
# The archive has no user accounts by design — reading and contributing need no
# login. There is exactly one maintainer account, and it gates /admin: the
# review queue, and everything that can write into data/people/.
#
# Unset, these fall back to admin / admin. That is fine on a laptop and
# unacceptable anywhere else — set them before this is reachable from the
# internet, because whoever finds the sign-in page can otherwise rewrite the
# archive.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Signs the session cookie. Optional: left unset it is derived from the
# password above, which means changing the password signs everybody out. Set it
# explicitly if you would rather sessions survived a password change.
# ADMIN_SESSION_SECRET=some-long-random-string
