# Copy to .env.local and set a real secret.
#
# Gates the /admin review queue and the /api/admin endpoint. There are no user
# accounts anywhere else in this project by design — reading and contributing
# need no login — so this one secret is the whole of the access control.
# If it is unset, the review queue refuses everyone rather than opening up.
ARCHIVE_REVIEW_KEY=change-me-to-something-long-and-random
