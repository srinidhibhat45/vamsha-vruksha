node_modules
.next
out
build
.DS_Store
*.pem
.env*.local
next-env.d.ts
tsconfig.tsbuildinfo

# Runtime submission queue (moderation inbox). Approved records get promoted
# into data/people/*.json and committed — git is the archive's provenance log.
data/submissions/*.jsonl
!data/submissions/.gitkeep

# Generated search / graph index
data/generated

# Contributed photographs written by the local development backend. In a
# deployment these go to Netlify Blobs instead (see lib/mediaStore.ts) — this
# directory only ever holds what was uploaded on somebody's own machine.
data/media

# public/temples/ is NOT ignored. Those images are fetched once by
# `npm run media:temples` and committed on purpose: an archive that depends on
# somebody else's server still serving a photograph in 2050 has not preserved
# anything. Their licences and photographers are in data/reference/temples.json.
